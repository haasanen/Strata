# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /terminal/data volume).
.git

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# terminal/setup.py outputs and downloads (packs, models, logs)
# fork patch: "/engine/" stays OUT of this list. 0.2.16 moved the engine sources INTO
# engine/ (package_terminal.py reads engine/CMakeLists.txt, the CUDA stage builds it);
# BuildKit applies this file to the whole context (dockerfile2dockerignore), so ignoring
# /engine/ strips the source and the from-source build dies on a missing CMakeLists.txt.
# The runtime dirs this rule once covered (setup.py's downloaded engine/, packs, models)
# never exist in a fresh CI checkout anyway.
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
# the folders tools/docker/entrypoint.sh creates in a mounted terminal/data/ (a link to llama.cpp, the models, the keys): never part of a build (#3644)
/data/install/
/data/state/
/data/home/
/data/Strata-data/
third_party/llama.cpp/
engine/third_party/*.zip
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
